# SOL-DEX-STREAMER Environment Configuration
# Copy this file to .env and fill in your values

# 1. Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. Your Solana Public Key to receive 0.50% (50 bps) platform fees atomically on every swap
# Example: 9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM
PLATFORM_FEE_WALLET="your_solana_wallet_address_here"
SOL_FEE_RECIPIENT="your_solana_wallet_address_here"

# 3. Optional: Custom Solana RPC endpoint (defaults to public mainnet-beta if omitted)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
